PORT=8080
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# How long a login session lasts, in hours.
SESSION_TTL_HOURS=168

# Outgoing email (sign-up verification codes). Without SMTP_HOST, codes are
# printed to the backend console instead (not allowed when NODE_ENV=production).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender shown to users. Defaults to "Nakka <SMTP_USER>" (required by Gmail).
MAIL_FROM=

# Google/GitHub sign-in via Clerk: Clerk Dashboard -> Configure -> API keys -> Secret key.
# Leave empty to disable those buttons.
CLERK_SECRET_KEY=

# AI providers (the extension's /v1/messages and /v1/chat/completions).
# A model whose provider has no key answers 503.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
# Billing page shown when an allowance runs out (402) and in GET /account.
MANAGE_URL=
# Website address, for redirecting GET /auth to its sign-in page.
FRONTEND_URL=http://localhost:3000
