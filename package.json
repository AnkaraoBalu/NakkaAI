{
  "name": "nakka",
  "private": true,
  "packageManager": "yarn@4.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "ui:dev": "turbo run dev --filter=@nakka/frontend",
    "ui:build": "turbo run build --filter=@nakka/frontend",
    "ui:preview": "turbo run preview --filter=@nakka/frontend",
    "backend:dev": "turbo run dev --filter=@nakka/backend",
    "backend:build": "turbo run build --filter=@nakka/backend",
    "backend:start": "yarn workspace @nakka/backend start",
    "build": "turbo run build",
    "preview": "turbo run preview",
    "typecheck": "turbo run typecheck",
    "backend:test": "yarn workspace @nakka/backend test",
    "backend:migrate": "yarn workspace @nakka/backend db:migrate"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  }
}
